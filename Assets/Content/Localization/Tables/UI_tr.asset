    m_Metadata:
      m_Items: []
  - m_Id: 261951220244483
    m_Localized: "Sat\u0131n alma ba\u015Far\u0131s\u0131z. Tekrar dene."
    m_Metadata:
      m_Items: []
  - m_Id: 261951220244484
    m_Localized: "Ma\u011Faza kullan\u0131lam\u0131yor. \u0130nternet ba\u011Flant\u0131n\u0131
      kontrol et."
    m_Metadata:
      m_Items: []
  - m_Id: 261951220244485
    m_Localized: "Sat\u0131n ald\u0131\u011F\u0131n i\xE7in te\u015Fekk\xFCrler!"
    m_Metadata:
      m_Items: []
  - m_Id: 261951220244486
