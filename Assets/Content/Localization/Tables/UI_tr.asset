      m_Items: []
  - m_Id: 261951220244480
    m_Localized: "Bug\xFCnl\xFCk \xFCcretsiz \xF6d\xFCl kalmad\u0131. Yar\u0131n
      gel!"
    m_Metadata:
      m_Items: []
  - m_Id: 261951220244481
    m_Localized: "Yeterli ta\u015F yok"
    m_Metadata:
      m_Items: []
  - m_Id: 261951220244482
