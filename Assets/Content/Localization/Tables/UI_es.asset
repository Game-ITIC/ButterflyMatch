    m_Localized: "\xA1Gemas: +{0}!"
    m_Metadata:
      m_Items: []
  - m_Id: 67562824949760
    m_Localized: "D\xEDa {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 68137218105344
    m_Localized: Recoge {0} mariposas
    m_Metadata:
      m_Items: []
  - m_Id: 68137222299648
    m_Localized: Usa potenciadores {0} veces
    m_Metadata:
      m_Items: []
  - m_Id: 68137222299649
    m_Localized: Completa {0} niveles
    m_Metadata:
      m_Items: []
