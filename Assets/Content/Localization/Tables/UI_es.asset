  - m_Id: 261951220244488
    m_Localized: Bloqueada
    m_Metadata:
      m_Items: []
  - m_Id: 261951220244489
    m_Localized: "\xA1{0} completada!\\nGemas: +{1}, potenciadores: +{2} de cada
      uno, vidas ilimitadas: {3} min"
    m_Metadata:
      m_Items: []
  - m_Id: 261951220244490
    m_Localized: "\xA1Pronto llegar\xE1n nuevas islas!"
